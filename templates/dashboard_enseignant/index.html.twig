{% extends 'base.html.twig' %}

{% block title %}UniFolio - Dashboard{% endblock %}

    {% block header %}

    {% endblock %}


{% block body %}
    <div class="content-container dashboard">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
        <section class="ev">
            <h1 class="ev-titre">Portfolios</h1>
            <p class="ev-chapo">
                {% if data_user.departement %}{{ data_user.departement.libelle }} · {% endif %}portfolios publiés par les étudiants
            </p>
            {{ component('AllPortfolioEvalComponent') }}
        </section>
        <hr>
        <section class="dashboard-eval-traces">
            <article class="row g-4"><h1>Traces</h1>
                <em>Toutes les traces des étudiants du département, développez pour évaluer</em>
                {{ component('AllTraceEvalComponent') }}
            </article>
        </section>
    </div>
{% endblock %}
