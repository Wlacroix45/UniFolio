<div{{ attributes.defaults({class: 'ev ev-liste'}) }}>
    {% set compteurs = this.compteurs %}
    {% set actif = this.statutActif %}

    <div class="ev-onglets" role="tablist" aria-label="Avancement de l'évaluation">
        {% for s in this.statuts %}
            <button type="button" role="tab" aria-selected="{{ s.value == actif.value ? 'true' : 'false' }}"
                    class="ev-onglet ev-statut--{{ s.value }}"
                    data-action="live#action" data-live-action-param="changerStatut"
                    data-live-statut-param="{{ s.value }}">
                <span class="ev-point"></span>
                {{ s.libelle }}
                <span class="ev-onglet__compte">{{ compteurs[s.value] }}</span>
            </button>
        {% endfor %}
    </div>

    <div class="ev-filtres">
        <label>
            <span class="ev-sur">Semestre</span>
            <select data-model="semestreId">
                <option value="0">Tous</option>
                {% for semestre in this.semestres %}
                    <option value="{{ semestre.id }}">{{ semestre.libelle }}{% if semestre.annee %} · {{ semestre.annee.libelle }}{% endif %}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            <span class="ev-sur">Groupe TP</span>
            <select data-model="groupeId">
                <option value="0">Tous</option>
                {% for groupe in this.groupes %}
                    <option value="{{ groupe.id }}">{{ groupe.libelle }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            <span class="ev-sur">Étudiant</span>
            <select data-model="etudiantId">
                <option value="0">Tous</option>
                {% for etudiant in this.etudiants %}
                    <option value="{{ etudiant.id }}">{{ etudiant.nom }} {{ etudiant.prenom }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            <span class="ev-sur">Compétence</span>
            <select data-model="niveauId">
                <option value="0">Toutes</option>
                {% for niveau in this.niveaux %}
                    <option value="{{ niveau.id }}">{{ niveau.competences ? niveau.competences.nomCourt ~ ' · ' }}{{ niveau.libelle }}</option>
                {% endfor %}
            </select>
        </label>
        {% if this.filtre %}
            <button type="button" class="ev-lien" data-action="live#action" data-live-action-param="reinitialiser">
                Effacer les filtres
            </button>
        {% endif %}
    </div>

    <div class="ev-table-zone" data-loading="addClass(ev-attente)">
        <table class="ev-table">
            <thead>
            <tr>
                <th scope="col">Étudiant</th>
                <th scope="col">Portfolio</th>
                <th scope="col">Semestre · groupe</th>
                <th scope="col" class="ev-num">Évaluées</th>
                <th scope="col" class="ev-num">Modifié le</th>
                <th scope="col"><span class="visually-hidden">Action</span></th>
            </tr>
            </thead>
            <tbody>
            {% for ligne in this.lignes %}
                {% set portfolio = ligne.portfolio %}
                {% set etudiant = portfolio.etudiant %}
                <tr class="ev-statut--{{ actif.value }}" data-live-id="portfolio-{{ portfolio.id }}">
                    <th scope="row">{{ etudiant.nom|upper }} {{ etudiant.prenom }}</th>
                    <td>{{ portfolio.intitule|default('Sans titre') }}</td>
                    <td>
                        {{ etudiant.semestre.libelle }}
                        {% for g in etudiant.groupe %}{% if g.typeGroupe and g.typeGroupe.type == 'TP' %} · {{ g.libelle }}{% endif %}{% endfor %}
                    </td>
                    <td class="ev-num">{{ ligne.evaluees }}/{{ ligne.total }}</td>
                    <td class="ev-num">{{ portfolio.dateModification ? portfolio.dateModification|date('d.m.Y') : '—' }}</td>
                    <td class="ev-action">
                        <a href="{{ path('app_evaluation_portfolio', {id: portfolio.id}) }}">
                            {{ actif.value == 'a_evaluer' ? 'Évaluer' : (actif.value == 'en_cours' ? 'Reprendre' : 'Consulter') }}
                            <span aria-hidden="true">→</span>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="ev-vide">
                        {% if not this.dataUserSession.departement %}
                            Aucun département actif.
                        {% else %}
                            Aucun portfolio dans « {{ actif.libelle }} »{{ this.filtre ? ' avec ces filtres' }}.
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if this.nombrePages > 1 %}
        <nav class="ev-pagination" aria-label="Pagination">
            <button type="button" class="ev-btn" {{ this.pageCourante == 1 ? 'disabled' }}
                    data-action="live#action" data-live-action-param="allerPage"
                    data-live-page-param="{{ this.pageCourante - 1 }}">Précédent</button>
            <span class="ev-num">Page {{ this.pageCourante }} / {{ this.nombrePages }}</span>
            <button type="button" class="ev-btn" {{ this.pageCourante == this.nombrePages ? 'disabled' }}
                    data-action="live#action" data-live-action-param="allerPage"
                    data-live-page-param="{{ this.pageCourante + 1 }}">Suivant</button>
        </nav>
    {% endif %}
</div>
