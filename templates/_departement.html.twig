{% if data_user.departement %}
    {% set currentRole = data_user.currentRoleLibelle %}
    {% set roleBadgeClass = data_user.isEditeur ? 'bg-primary' : 'bg-secondary' %}

    {% if data_user.allDepartementsEnseignant|length <= 1 %}
        <p class="mb-0 d-flex align-items-center gap-2">
            <span>{{ data_user.departement.libelle }}</span>
            {% if currentRole %}
                <span class="badge {{ roleBadgeClass }}">{{ currentRole }}</span>
            {% endif %}
        </p>
    {% else %}
        <form action="{{ path('app_choix_departement') }}" method="post" class="dept_list">
            <div class="dropdown">
                <button type="button"
                        class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-2"
                        id="dropdownMenuButton1"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <span>{{ data_user.departement.libelle }}</span>
                    {% if currentRole %}
                        <span class="badge {{ roleBadgeClass }}">{{ currentRole }}</span>
                    {% endif %}
                    <i class="fa-solid fa-shuffle"></i>
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                    {% for ed in data_user.enseignantDepartements %}
                        {% if ed.departement %}
                            <li>
                                <button type="submit"
                                        class="dropdown-item d-flex justify-content-between align-items-center gap-3{% if ed.departement.id == data_user.departement.id %} active{% endif %}"
                                        name="departement"
                                        value="{{ ed.departement.id }}">
                                    <span>{{ ed.departement.libelle }}</span>
                                    <span class="badge {{ ed.isEditeur ? 'bg-primary' : 'bg-secondary' }}">
                                        {{ ed.role.libelle }}
                                    </span>
                                </button>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </form>
    {% endif %}
{% endif %}