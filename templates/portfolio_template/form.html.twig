{% extends 'base.html.twig' %}

{% block title %}
    UniFolio - {{ isEdit ? 'Modifier le modèle' : 'Nouveau modèle de portfolio' }}
{% endblock %}

{% macro section_card(sectionForm) %}
    <div class="card mb-3 section-item shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <span class="fw-semibold section-title-label">Section</span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary btn-move-up" title="Monter">
                    <i class="fa-solid fa-arrow-up"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-move-down" title="Descendre">
                    <i class="fa-solid fa-arrow-down"></i>
                </button>
                <button type="button" class="btn btn-outline-danger btn-remove-section" title="Supprimer">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    {{ form_row(sectionForm.ordre) }}
                </div>
                <div class="col-md-10">
                    {{ form_row(sectionForm.titre) }}
                </div>
                <div class="col-12">
                    {{ form_row(sectionForm.consigne) }}
                </div>
                <div class="col-12">
                    {{ form_row(sectionForm.questionReflexivePrompt) }}
                </div>
                <div class="col-12">
                    {{ form_row(sectionForm.competencesCibles) }}
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% import _self as macros %}

{% block body %}
    <div class="content-container">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('enseignant_dashboard') }}">Dashboard</a></li>
                <li class="breadcrumb-item">
                    <a href="{{ path('app_portfolio_template_index') }}">Modèles de portfolio</a>
                </li>
                {% if isEdit and template.id %}
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_portfolio_template_show', {'id': template.id}) }}">{{ template.nom }}</a>
                    </li>
                {% endif %}
                <li class="breadcrumb-item active" aria-current="page">
                    {{ isEdit ? 'Modifier' : 'Nouveau modèle' }}
                </li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-1">{{ isEdit ? 'Modifier le modèle de portfolio' : 'Créer un modèle de portfolio' }}</h1>
                {% if departement %}
                    <p class="text-muted mb-0">Département : <strong>{{ departement.libelle }}</strong></p>
                {% endif %}
            </div>
            {% if isEdit and template.statut %}
                <span class="badge {{ template.statut.badgeClass }} fs-6">{{ template.statut.libelle }}</span>
            {% endif %}
        </div>

        {% if isEdit and template.isPublished %}
            <div class="alert alert-info">
                Ce modèle est actuellement <strong>publié</strong>. Les modifications s'appliqueront uniquement aux
                nouveaux portfolios démarrés par les étudiants ; les portfolios en cours conservent leur snapshot figé.
            </div>
        {% endif %}

        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Informations générales et cadrage PN</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        {{ form_row(form.nom) }}
                    </div>
                    <div class="col-12">
                        {{ form_row(form.description) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.apcReferentiel) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.annee) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.apcParcours) }}
                    </div>
                    <div class="col-12">
                        {{ form_row(form.competencesCibles) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 mb-0">Sections du portfolio guidé</h2>
                <small class="text-muted">Définissez les étapes ordonnées et les consignes pour l'étudiant.</small>
            </div>
            <button type="button" id="add-section-btn" class="btn btn-outline-primary">
                <i class="fa-solid fa-plus me-1"></i> Ajouter une section
            </button>
        </div>

        <div id="sections-container"
             data-prototype="{{ macros.section_card(form.sections.vars.prototype)|e('html_attr') }}"
             data-index="{{ form.sections|length }}">
            {% for sectionForm in form.sections %}
                {{ macros.section_card(sectionForm) }}
            {% endfor %}
        </div>

        {% do form.sections.setRendered() %}

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk me-1"></i>
                {{ isEdit ? 'Enregistrer les modifications' : 'Créer le brouillon' }}
            </button>
            <a href="{{ isEdit and template.id ? path('app_portfolio_template_show', {'id': template.id}) : path('app_portfolio_template_index') }}"
               class="btn btn-outline-secondary">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('sections-container');
            const addButton = document.getElementById('add-section-btn');
            if (!container || !addButton) {
                return;
            }

            let index = parseInt(container.dataset.index || '0', 10);

            function renumberSections() {
                const items = container.querySelectorAll('.section-item');
                items.forEach(function (item, idx) {
                    const orderInput = item.querySelector('.section-ordre-input');
                    if (orderInput) {
                        orderInput.value = idx + 1;
                    }
                    const titleLabel = item.querySelector('.section-title-label');
                    if (titleLabel) {
                        titleLabel.textContent = 'Section ' + (idx + 1);
                    }
                });
            }

            function bindSectionEvents(item) {
                const removeBtn = item.querySelector('.btn-remove-section');
                const upBtn = item.querySelector('.btn-move-up');
                const downBtn = item.querySelector('.btn-move-down');

                if (removeBtn) {
                    removeBtn.addEventListener('click', function () {
                        item.remove();
                        renumberSections();
                    });
                }

                if (upBtn) {
                    upBtn.addEventListener('click', function () {
                        const prev = item.previousElementSibling;
                        if (prev) {
                            container.insertBefore(item, prev);
                            renumberSections();
                        }
                    });
                }

                if (downBtn) {
                    downBtn.addEventListener('click', function () {
                        const next = item.nextElementSibling;
                        if (next) {
                            container.insertBefore(next, item);
                            renumberSections();
                        }
                    });
                }
            }

            container.querySelectorAll('.section-item').forEach(bindSectionEvents);
            renumberSections();

            addButton.addEventListener('click', function () {
                const prototype = container.dataset.prototype;
                const html = prototype.replace(/__name__/g, String(index));
                index += 1;
                container.dataset.index = String(index);

                const wrapper = document.createElement('div');
                wrapper.innerHTML = html;
                const newItem = wrapper.firstElementChild;
                if (newItem) {
                    container.appendChild(newItem);
                    bindSectionEvents(newItem);
                    renumberSections();
                }
            });
        });
    </script>
{% endblock %}
