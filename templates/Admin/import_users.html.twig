{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form '@EasyAdmin/symfony-form-themes/bootstrap_5_layout.html.twig' %}

{% block content_title %}
    Importer des utilisateurs (CSV)
{% endblock %}

{% block main %}
    <div class="row g-4" data-controller="import-users">
        <div class="col-12 col-xl-8">
            <div class="alert alert-danger d-none" role="alert" data-import-users-target="errorBox">
                <div class="d-flex align-items-start gap-2">
                    <i class="fas fa-circle-exclamation mt-1"></i>
                    <div>
                        <span data-import-users-target="errorMessage"></span>
                        <div class="small mt-1 opacity-75">
                            Aucun utilisateur n'a été créé en base de données suite à cette erreur.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-success shadow-sm mb-4 d-none" data-import-users-target="resultBox">
                <div class="card-header bg-success text-white d-flex align-items-center justify-content-between">
                    <span><i class="fas fa-circle-check me-2"></i>Import terminé</span>
                    <button type="button" class="btn btn-sm btn-outline-light" data-action="click->import-users#resetView">
                        Nouvel import
                    </button>
                </div>
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <p class="mb-0">
                        <strong data-import-users-target="resultCount">0</strong>
                        compte(s) créé(s) avec succès.
                    </p>

                    <form method="post"
                          action="{{ path('admin_import_users_download') }}"
                          data-import-users-target="downloadForm">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('import_users_download') }}">
                        <input type="hidden" name="token" value="" data-import-users-target="downloadToken">
                        <button type="submit" class="btn btn-sm btn-success">
                            <i class="fas fa-download me-1"></i>Télécharger comptes.csv
                        </button>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    {{ form_start(form, {
                        action: path('admin_import_users_index'),
                        attr: {
                            'data-import-users-target': 'form',
                            'data-action': 'submit->import-users#submit',
                            'novalidate': 'novalidate'
                        }
                    }) }}

                    <div class="mb-4">
                        {{ form_row(form.defaultRole) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.fichier, null, { label_attr: { class: 'form-label fw-semibold' } }) }}

                        <label for="{{ form.fichier.vars.id }}"
                               class="ea-import-dropzone"
                               data-import-users-target="dropzone"
                               data-action="dragenter->import-users#dragOver dragover->import-users#dragOver dragleave->import-users#dragLeave drop->import-users#drop">

                            {{ form_widget(form.fichier, {
                                attr: {
                                    'class': 'ea-import-dropzone__input',
                                    'data-import-users-target': 'fileInput',
                                    'data-action': 'change->import-users#syncFile'
                                }
                            }) }}

                            <div class="ea-import-dropzone__empty">
                                <div class="ea-import-dropzone__icon">
                                    <i class="fas fa-cloud-arrow-up"></i>
                                </div>
                                <p class="fw-semibold mb-1">Glissez-déposez votre fichier CSV ici</p>
                                <p class="text-muted small mb-2">ou cliquez pour parcourir votre ordinateur</p>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                    Format accepté : .csv (10 Mo max.)
                                </span>
                            </div>

                            <div class="ea-import-dropzone__selected">
                                <div class="ea-import-file-badge">
                                    <i class="fas fa-file-csv fa-lg text-success"></i>
                                    <span class="ea-import-file-badge__name" data-import-users-target="fileName"></span>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger ms-1"
                                            aria-label="Retirer le fichier"
                                            data-action="click->import-users#clearFile">
                                        <i class="fas fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </label>

                        {{ form_errors(form.fichier) }}
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit"
                                class="btn btn-primary ea-import-submit"
                                disabled
                                data-import-users-target="submitBtn">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <i class="fas fa-file-import me-1"></i>
                            Importer les utilisateurs
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <i class="fas fa-circle-info me-2"></i>Format du fichier CSV
                </div>
                <div class="card-body small">
                    <p class="mb-2">
                        <strong>Colonnes obligatoires :</strong>
                        <code>nom</code>, <code>prenom</code>, <code>mail</code>
                    </p>
                    <p class="mb-2">
                        <strong>Colonne optionnelle :</strong>
                        <code>role</code> (<code>etudiant</code> ou <code>enseignant</code>)
                    </p>
                    <p class="mb-3 text-muted">
                        Les séparateurs <code>;</code>, <code>,</code> et tabulation sont détectés automatiquement (encodage UTF-8 recommandé).
                    </p>
                    <p class="mb-3 text-muted">
                        En cas d'erreur sur une ligne ou une colonne, la transaction est annulée : aucun compte partiel n'est créé.
                    </p>
                    <a href="{{ path('admin_import_users_template') }}" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="fas fa-file-arrow-down me-1"></i>Télécharger un modèle CSV
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
